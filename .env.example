# Optional. Defaults to 4000. Port 3000 is in use on this machine.
# PORT=4000

# Free off-topic chat questions per visitor, per window. Spanish questions are
# answered from the site's own data and never count. Set the limit to 1 to see
# the tape effect quickly.
# CHAT_FREE_LIMIT=10
# CHAT_WINDOW_MINUTES=30

# --- Language model for off-topic chat, translation and example sentences ----
# Spanish questions never reach a model: the tutor answers them from the site's
# own data. Pick whichever of these you have; free tiers are tried first.

# Free. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Free. https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Paid. https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Free overflow, used once the primary allowance is spent.
# https://openrouter.ai/settings/keys
# Only ":free" models are accepted, and every request carries a zero price
# ceiling, so this cannot be billed. See the README for the account settings.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Questions allowed in the overflow tier per window (the primary uses
# CHAT_FREE_LIMIT above).
# CHAT_OVERFLOW_LIMIT=20

# Force one instead of auto-detecting: gemini | groq | openrouter | anthropic
# LLM_PROVIDER=gemini
