# Optional. Defaults to 4000. Port 3000 is in use on this machine.
# PORT=4000

# Free off-topic chat questions per visitor, per window. Spanish questions are
# answered from the site's own data and never count. Set the limit to 1 to see
# the tape effect quickly.
# CHAT_FREE_LIMIT=5
# CHAT_WINDOW_MINUTES=30

# Translation runs on Lingva instances, which are volunteer-run and do go down —
# lingva.ml and lingva.garudalinux.org currently sit behind a Cloudflare
# challenge. One that fails is rested for a minute rather than re-asked on every
# translation. No key, no model.
#
# An entry may carry its own scheme, which is how a self-hosted instance is
# pointed at — the durable answer if the public ones keep failing:
#   docker run -d -p 3100:3000 --restart unless-stopped \
#     --name lingva ghcr.io/thedaviddelta/lingva-translate:latest
# LINGVA_INSTANCES=http://localhost:3100,lingva.lunar.icu

# DeepL. The best engine here for French and Spanish, and the first one tried.
# Free tier: 500,000 characters a month, which a class typing sentences will not
# come close to spending. Only a free key (ending ":fx") is used: a Pro key is
# billed per character, so one is ignored. It has no Latin — nothing dedicated
# does — so Latin falls to the model. https://www.deepl.com/pro-api
# DEEPL_API_KEY=

# MyMemory rations anonymous use by IP, and a deployed site shares its IP with
# whatever else the host is running — which is why translation can work on your
# laptop and answer 429 in production. Naming a contact address is MyMemory's
# own way of asking for the larger allowance (1,000 → 10,000 words a day); it
# is sent to MyMemory with every translation, so use an address you don't mind
# them having. Worth setting on the deployed site: French and Latin have no
# engine behind MyMemory.
# MYMEMORY_EMAIL=you@example.com

# Dictionary. Without a key rae-api.com allows 10 requests a minute and 100 a
# day; a free self-service key raises that to 60/minute and 5,000/day.
# https://rae-api.com/login
# RAE_API_KEY=

# Pronunciation on the dictionary page, from ElevenLabs. The free tier is
# 10,000 characters a month for the whole site, so clips are cached and only
# single words are spoken. Without a key the speaker button removes itself.
# The key needs the text_to_speech permission; a free account cannot use voices
# from the voice library, so the default voice is a premade one.
# Use a free account: it has no card on file, so past the month's characters
# it refuses rather than charges.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2

# The padlock that seals the site for everyone. Case-insensitive.
# TEACHER_PASSCODE=AP_Lit

# French and Latin are closed until somebody types this in the padlock, and it
# opens them for that browser only — the server records nothing. There is no
# word that closes them again; clearing site storage gives the key back.
# RELEASE_PASSCODE=profe

# Keeps per-browser identities, and so allowances, across restarts.
# SESSION_SECRET=

# Set only when the app really is behind a proxy you control. It makes the
# per-visitor allowance trust X-Forwarded-For, which any client can send.
# TRUST_PROXY=1

# --- Language model for off-topic chat, translation and example sentences ----
# Spanish questions never reach a model: the tutor answers them from the site's
# own data. Every provider here is a free tier, and a paid one is refused in
# code (server/llm.js). Pick whichever of these you have.
#
# The one thing code cannot see is your account: Gemini and Groq bill only if
# you turn billing on for the key's project or account. Create these keys
# somewhere billing is off and they stay free; at the cap they answer 429 and
# the chat moves to the next provider.

# Free. https://aistudio.google.com/apikey — from a project without billing.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Free. https://console.groq.com/keys — on the free plan, no card.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Free overflow, used once the primary allowance is spent.
# https://openrouter.ai/settings/keys
# Only ":free" models are accepted, and every request carries a zero price
# ceiling, so this cannot be billed. See the README for the account settings.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Force one instead of auto-detecting: gemini | groq | openrouter
# LLM_PROVIDER=gemini
